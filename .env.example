# Zajuna Frontend - Environment Variables Template
# Copy this file to .env and fill with your actual values

# Backend API Configuration - Unified endpoint
REACT_APP_API_URL=http://localhost:8080/api
REACT_APP_USERS_API=http://localhost:8080/api
REACT_APP_COURSES_API=http://localhost:8080/api

# API Key for authentication
REACT_APP_API_KEY=your_api_key_here

# Development server port (React default)
PORT=3000

